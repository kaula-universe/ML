import "ops.kl"
import std.math
import std.memory
import std.random

// 重置 std.random 全局生成器；MLP 构造时自动 seed，用户亦可显式调用
export fn ml_seed(u64 s) {
    std.random.random_seed(s)
}

// 激活函数 ID 常量
// 注意：新编译器将大写开头的标识符视为类型（class/struct）名，
// 全大写的全局常量会被误判为类型，故统一改用小写命名。
i32 act_linear = 0
i32 act_relu = 1
i32 act_sigmoid = 2
i32 act_tanh = 3
i32 act_leaky_relu = 4
i32 act_elu = 5
i32 act_swish = 6

// 全连接层：y = act(W·x + b)
// 前向缓存 x 供反向使用；反向同时累积 gw/gb，update() 时应用
export class Linear {
    nin: i32
    nout: i32
    act: i32
    lr: f64
    mom: f64
    w: f64*
    b: f64*
    xin: f64*
    z: f64*
    y: f64*
    gw: f64*
    gb: f64*
    gx: f64*
    d: f64*
    vw: f64*
    vb: f64*

    constructor(i32 nin, i32 nout, f64 lr, i32 act) {
        self.nin = nin
        self.nout = nout
        self.lr = lr
        self.act = act
        self.mom = 0.0
        self.w = as<f64*>(std.memory.kmm_v4_global_alloc(nin * nout * 8))
        self.b = as<f64*>(std.memory.kmm_v4_global_alloc(nout * 8))
        self.xin = as<f64*>(std.memory.kmm_v4_global_alloc(nin * 8))
        self.z = as<f64*>(std.memory.kmm_v4_global_alloc(nout * 8))
        self.y = as<f64*>(std.memory.kmm_v4_global_alloc(nout * 8))
        self.gw = as<f64*>(std.memory.kmm_v4_global_alloc(nin * nout * 8))
        self.gb = as<f64*>(std.memory.kmm_v4_global_alloc(nout * 8))
        self.gx = as<f64*>(std.memory.kmm_v4_global_alloc(nin * 8))
        self.d = as<f64*>(std.memory.kmm_v4_global_alloc(nout * 8))
        self.vw = as<f64*>(std.memory.kmm_v4_global_alloc(nin * nout * 8))
        self.vb = as<f64*>(std.memory.kmm_v4_global_alloc(nout * 8))
        f64 scale = std.math.math_sqrt(2.0 / as<f64>(nin))
        for i in range(self.size_w()) {
            f64 r = std.random.random_f64()
            self.w[i] = (r * 2.0 - 1.0) * scale
        }
    }

    fn size_w() i32 {
        return self.nin * self.nout
    }

    fn set_momentum(f64 m) {
        self.mom = m
    }

    fn forward(f64* x) f64* {
        for i in range(self.nin) {
            self.xin[i] = x[i]
        }
        for j in range(self.nout) {
            f64 acc = self.b[j]
            for k in range(self.nin) {
                acc = acc + self.w[k * self.nout + j] * self.xin[k]
            }
            self.z[j] = acc
            self.y[j] = acc
        }
        if self.act == act_relu {
            ops_relu(self.y, self.nout)
        }
        if self.act == act_sigmoid {
            ops_sigmoid(self.y, self.nout)
        }
        if self.act == act_tanh {
            ops_tanh(self.y, self.nout)
        }
        if self.act == act_leaky_relu {
            ops_leaky_relu(self.y, 0.01, self.nout)
        }
        if self.act == act_elu {
            ops_elu(self.y, 1.0, self.nout)
        }
        if self.act == act_swish {
            ops_swish(self.y, self.nout)
        }
        return self.y
    }

    fn backward(f64* dy) f64* {
        for j in range(self.nout) {
            f64 dz = 1.0
            if self.act == act_relu {
                if self.z[j] <= 0.0 {
                    dz = 0.0
                }
            }
            if self.act == act_sigmoid {
                dz = self.y[j] * (1.0 - self.y[j])
            }
            if self.act == act_tanh {
                dz = 1.0 - self.y[j] * self.y[j]
            }
            if self.act == act_leaky_relu {
                if self.z[j] > 0.0 {
                    dz = 1.0
                } else {
                    dz = 0.01
                }
            }
            if self.act == act_elu {
                if self.z[j] > 0.0 {
                    dz = 1.0
                } else {
                    dz = self.y[j] + 1.0  // ELU(x) + 1 当 x <= 0
                }
            }
            if self.act == act_swish {
                f64 s = 1.0 / (1.0 + ops_exp(-self.z[j]))
                dz = s + self.z[j] * s * (1.0 - s)
            }
            self.d[j] = dy[j] * dz
        }
        for i in range(self.gx_len()) {
            self.gx[i] = 0.0
        }
        for j in range(self.nout) {
            self.gb[j] = self.gb[j] + self.d[j]
            for k in range(self.nin) {
                self.gw[k * self.nout + j] = self.gw[k * self.nout + j] + self.xin[k] * self.d[j]
                self.gx[k] = self.gx[k] + self.w[k * self.nout + j] * self.d[j]
            }
        }
        return self.gx
    }

    fn gx_len() i32 {
        return self.nin
    }

    // 动量 SGD：v = mom·v + lr·g；w -= v（mom=0 时退化为普通 SGD）
    fn update() {
        for i in range(self.size_w()) {
            f64 g = self.gw[i]
            self.gw[i] = 0.0
            if self.mom > 0.0 {
                self.vw[i] = self.mom * self.vw[i] + self.lr * g
                self.w[i] = self.w[i] - self.vw[i]
            } else {
                self.w[i] = self.w[i] - self.lr * g
            }
        }
        for j in range(self.nout) {
            f64 g = self.gb[j]
            self.gb[j] = 0.0
            if self.mom > 0.0 {
                self.vb[j] = self.mom * self.vb[j] + self.lr * g
                self.b[j] = self.b[j] - self.vb[j]
            } else {
                self.b[j] = self.b[j] - self.lr * g
            }
        }
    }
}

// 多层感知机（任意层数堆叠 + 反向传播）
// dims: 每层宽度，共 cnt+1 项（输入维度 + 各隐藏层/输出维度）
// acts: 每层激活，共 cnt 项（0=linear, 1=relu, 2=sigmoid, 3=tanh）
// 分类训练（train_step_ce / predict_softmax）时最后一层请用 act=0：
// 输出层为 logits，predict_softmax 会施加 softmax，CE 反向也按 softmax+CE 处理。
export class MLP {
    cnt: i32
    layers: Linear*

    constructor(i32* dims, i32 cnt, i32* acts, f64 lr) {
        ml_seed(123456789)
        self.cnt = cnt
        self.layers = as<Linear*>(std.memory.kmm_v4_global_alloc(cnt * 8))
        for l in range(cnt) {
            Linear lin = Linear(dims[l], dims[l + 1], lr, acts[l])
            self.layers[l] = lin
        }
    }

    fn set_momentum(f64 m) {
        for l in range(self.cnt) {
            Linear lin = self.layers[l]
            lin.set_momentum(m)
        }
    }

    fn predict(f64* x) f64* {
        f64* cur = x
        for l in range(self.cnt) {
            Linear lin = self.layers[l]
            cur = lin.forward(cur)
        }
        return cur
    }

    // 分类预测：输出层 logits 施加 softmax，返回概率分布
    fn predict_softmax(f64* x) f64* {
        f64* cur = self.predict(x)
        Linear last = self.layers[self.cnt - 1]
        ops_softmax(cur, last.nout)
        return cur
    }

    fn loss(f64* x, f64* y_true) f64 {
        f64* y = self.predict(x)
        Linear last = self.layers[self.cnt - 1]
        return ops_mse(y, y_true, last.nout)
    }

    fn loss_ce(f64* x, f64* y_true) f64 {
        f64* y = self.predict_softmax(x)
        Linear last = self.layers[self.cnt - 1]
        return ops_cross_entropy(y, y_true, last.nout)
    }

    fn train_step(f64* x, f64* y_true) f64 {
        f64* y = self.predict(x)
        Linear last = self.layers[self.cnt - 1]
        f64 loss = ops_mse(y, y_true, last.nout)
        f64* dy = as<f64*>(std.memory.kmm_v4_alloc(last.nout * 8))
        ops_mse_deriv(y, y_true, dy, last.nout)
        f64* g = dy
        i32 idx = self.cnt - 1
        while idx >= 0 {
            Linear lin = self.layers[idx]
            g = lin.backward(g)
            lin.update()
            idx = idx - 1
        }
        std.memory.kmm_v4_free(dy)
        return loss
    }

    // 交叉熵 + softmax 训练（最后一层须为 act=0，输出为 logits）
    fn train_step_ce(f64* x, f64* y_true) f64 {
        f64* y = self.predict_softmax(x)
        Linear last = self.layers[self.cnt - 1]
        f64 loss = ops_cross_entropy(y, y_true, last.nout)
        f64* dy = as<f64*>(std.memory.kmm_v4_alloc(last.nout * 8))
        ops_cross_entropy_deriv(y, y_true, dy, last.nout)
        f64* g = dy
        i32 idx = self.cnt - 1
        while idx >= 0 {
            Linear lin = self.layers[idx]
            g = lin.backward(g)
            lin.update()
            idx = idx - 1
        }
        std.memory.kmm_v4_free(dy)
        return loss
    }
}

// ============================================================
// Conv2d: 2D 卷积层
// 输入: [batch, ich, ih, iw]（行优先展平）
// 输出: [batch, och, oh, ow]
// oh = (ih + 2*pad - kernel) / stride + 1
// ow = (iw + 2*pad - kernel) / stride + 1
// ============================================================
export class Conv2d {
    ich: i32
    och: i32
    ksz: i32
    str: i32
    pad: i32
    lr: f64
    weight: f64*
    bias: f64*
    gw: f64*
    gb: f64*
    vx: f64*
    ih: i32
    iw: i32
    oh: i32
    ow: i32

    constructor(i32 a_ich, i32 a_och, i32 a_ksz, i32 a_str, i32 a_pad, f64 a_lr) {
        self.ich = a_ich
        self.och = a_och
        self.ksz = a_ksz
        self.str = a_str
        self.pad = a_pad
        self.lr = a_lr
        i32 fan_in = a_ich * a_ksz * a_ksz
        f64 scale = std.math.math_sqrt(2.0 / as<f64>(fan_in))
        i32 wsize = a_och * a_ich * a_ksz * a_ksz
        self.weight = as<f64*>(std.memory.kmm_v4_global_alloc(wsize * 8))
        self.bias = as<f64*>(std.memory.kmm_v4_global_alloc(a_och * 8))
        self.gw = as<f64*>(std.memory.kmm_v4_global_alloc(wsize * 8))
        self.gb = as<f64*>(std.memory.kmm_v4_global_alloc(a_och * 8))
        i32 idx = 0
        while idx < wsize {
            f64 r = std.random.random_f64()
            self.weight[idx] = (r * 2.0 - 1.0) * scale
            idx = idx + 1
        }
        i32 bi = 0
        while bi < a_och {
            self.bias[bi] = 0.0
            bi = bi + 1
        }
    }

    // 前向: 输入 x 形状 [batch, ich, ih, iw]
    fn forward(f64* x, i32 batch, i32 a_ih, i32 a_iw) f64* {
        self.ih = a_ih
        self.iw = a_iw
        self.oh = (a_ih + 2 * self.pad - self.ksz) / self.str + 1
        self.ow = (a_iw + 2 * self.pad - self.ksz) / self.str + 1
        i32 out_size = batch * self.och * self.oh * self.ow
        f64* out = as<f64*>(std.memory.kmm_v4_global_alloc(out_size * 8))

        // 缓存输入
        i32 in_size = batch * self.ich * a_ih * a_iw
        if self.vx != null {
            std.memory.kmm_v4_free(self.vx)
        }
        self.vx = as<f64*>(std.memory.kmm_v4_global_alloc(in_size * 8))
        ops_copy(x, self.vx, in_size)

        // 卷积
        i32 b = 0
        while b < batch {
            i32 oc = 0
            while oc < self.och {
                i32 oh = 0
                while oh < self.oh {
                    i32 ow = 0
                    while ow < self.ow {
                        f64 acc = self.bias[oc]
                        i32 ic = 0
                        while ic < self.ich {
                            i32 kh = 0
                            while kh < self.ksz {
                                i32 kw = 0
                                while kw < self.ksz {
                                    i32 ih = oh * self.str + kh - self.pad
                                    i32 iw2 = ow * self.str + kw - self.pad
                                    if ih >= 0 && ih < a_ih && iw2 >= 0 && iw2 < a_iw {
                                        i32 xi = ((b * self.ich + ic) * a_ih + ih) * a_iw + iw2
                                        i32 wi = ((oc * self.ich + ic) * self.ksz + kh) * self.ksz + kw
                                        acc = acc + x[xi] * self.weight[wi]
                                    }
                                    kw = kw + 1
                                }
                                kh = kh + 1
                            }
                            ic = ic + 1
                        }
                        i32 oi = ((b * self.och + oc) * self.oh + oh) * self.ow + ow
                        out[oi] = acc
                        ow = ow + 1
                    }
                    oh = oh + 1
                }
                oc = oc + 1
            }
            b = b + 1
        }
        return out
    }

    // 反向: dy 形状 [batch, och, oh, ow]
    fn backward(f64* dy, i32 batch) {
        i32 wsize = self.och * self.ich * self.ksz * self.ksz
        i32 gi = 0
        while gi < wsize {
            self.gw[gi] = 0.0
            gi = gi + 1
        }
        i32 bi = 0
        while bi < self.och {
            self.gb[bi] = 0.0
            bi = bi + 1
        }
        // 计算权重梯度和偏置梯度
        i32 b = 0
        while b < batch {
            i32 oc = 0
            while oc < self.och {
                i32 ohi = 0
                while ohi < self.oh {
                    i32 owi = 0
                    while owi < self.ow {
                        i32 oi = ((b * self.och + oc) * self.oh + ohi) * self.ow + owi
                        f64 d = dy[oi]
                        self.gb[oc] = self.gb[oc] + d
                        i32 ic = 0
                        while ic < self.ich {
                            i32 kh = 0
                            while kh < self.ksz {
                                i32 kw = 0
                                while kw < self.ksz {
                                    i32 ih = ohi * self.str + kh - self.pad
                                    i32 iw2 = owi * self.str + kw - self.pad
                                    if ih >= 0 && ih < self.ih && iw2 >= 0 && iw2 < self.iw {
                                        i32 xi = ((b * self.ich + ic) * self.ih + ih) * self.iw + iw2
                                        i32 wi = ((oc * self.ich + ic) * self.ksz + kh) * self.ksz + kw
                                        self.gw[wi] = self.gw[wi] + self.vx[xi] * d
                                    }
                                    kw = kw + 1
                                }
                                kh = kh + 1
                            }
                            ic = ic + 1
                        }
                        owi = owi + 1
                    }
                    ohi = ohi + 1
                }
                oc = oc + 1
            }
            b = b + 1
        }
        // 更新参数
        gi = 0
        while gi < wsize {
            self.weight[gi] = self.weight[gi] - self.lr * self.gw[gi]
            gi = gi + 1
        }
        bi = 0
        while bi < self.och {
            self.bias[bi] = self.bias[bi] - self.lr * self.gb[bi]
            bi = bi + 1
        }
    }

    fn output_size() i32 {
        return self.och * self.oh * self.ow
    }
}

// MaxPool2d: 最大池化层
export class MaxPool2d {
    ksz: i32
    spt: i32

    constructor(i32 a_ksz, i32 a_spt) {
        self.ksz = a_ksz
        self.spt = a_spt
    }

    // 前向: [batch, ch, ih, iw] -> [batch, ch, oh, ow]
    fn forward(f64* x, i32 batch, i32 ch, i32 ih, i32 iw) f64* {
        i32 oh = (ih - self.ksz) / self.spt + 1
        i32 ow = (iw - self.ksz) / self.spt + 1
        i32 out_size = batch * ch * oh * ow
        f64* out = as<f64*>(std.memory.kmm_v4_global_alloc(out_size * 8))
        i32 b = 0
        while b < batch {
            i32 c = 0
            while c < ch {
                i32 ohi = 0
                while ohi < oh {
                    i32 owi = 0
                    while owi < ow {
                        f64 mx = -1e30
                        i32 kh = 0
                        while kh < self.ksz {
                            i32 kw = 0
                            while kw < self.ksz {
                                i32 ih2 = ohi * self.spt + kh
                                i32 iw2 = owi * self.spt + kw
                                if ih2 < ih && iw2 < iw {
                                    i32 xi = ((b * ch + c) * ih + ih2) * iw + iw2
                                    if x[xi] > mx {
                                        mx = x[xi]
                                    }
                                }
                                kw = kw + 1
                            }
                            kh = kh + 1
                        }
                        i32 oi = ((b * ch + c) * oh + ohi) * ow + owi
                        out[oi] = mx
                        owi = owi + 1
                    }
                    ohi = ohi + 1
                }
                c = c + 1
            }
            b = b + 1
        }
        return out
    }
}

// Flatten: 将 [batch, ch, h, w] 展平为 [batch, ch*h*w]
export fn flatten_forward(f64* x, i32 batch, i32 ch, i32 h, i32 w) f64* {
    i32 dim = ch * h * w
    i32 total = batch * dim
    f64* out = as<f64*>(std.memory.kmm_v4_global_alloc(total * 8))
    ops_copy(x, out, total)
    return out
}