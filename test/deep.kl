import "../nn.kl"
import std.io
import std.memory

// 深层 MLP：2-3-3-1 两层隐藏层 + 动量，MSE 训练 XOR（验证 N 层反向传播）
fn main() {
    i32* dims = as<i32*>(std.memory.kmm_v4_alloc(4 * 4))
    i32* acts = as<i32*>(std.memory.kmm_v4_alloc(3 * 4))
    dims[0] = 2; dims[1] = 3; dims[2] = 3; dims[3] = 1
    acts[0] = 1; acts[1] = 1; acts[2] = 2
    MLP net = MLP(dims, 3, acts, 0.05)
    net.set_momentum(0.9)

    f64* x = as<f64*>(std.memory.kmm_v4_alloc(4 * 2 * 8))
    f64* t = as<f64*>(std.memory.kmm_v4_alloc(4 * 8))
    x[0] = 0.0; x[1] = 0.0; t[0] = 0.0
    x[2] = 0.0; x[3] = 1.0; t[1] = 1.0
    x[4] = 1.0; x[5] = 0.0; t[2] = 1.0
    x[6] = 1.0; x[7] = 1.0; t[3] = 0.0

    i32 epoch = 0
    while epoch < 8000 {
        f64 total = 0.0
        for s in range(4) {
            f64* xs = &x[s * 2]
            f64* ts = &t[s]
            total = total + net.train_step(xs, ts)
        }
        epoch = epoch + 1
    }

    i32 correct = 0
    for s in range(4) {
        f64* xs = &x[s * 2]
        f64* ts = &t[s]
        f64* y = net.predict(xs)
        i32 pred = 0
        if y[0] > 0.5 {
            pred = 1
        }
        i32 expect = as<i32>(ts[0])
        if pred == expect {
            correct = correct + 1
        }
        std.io.println("xor(", xs[0], ",", xs[1], ") pred ", pred, " expect ", expect)
    }
    std.io.println("accuracy = ", as<f64>(correct) / 4.0)
}