import "ops.kl"
import std.memory
import std.random

// 批归一化层（Batch Normalization）
// 训练时: 用当前 batch 的均值/方差归一化
// 推理时: 用训练时累积的运行均值/方差
export class BatchNorm {
    i32 dim           // 特征维度
    f64 eps           // 数值稳定性
    f64 momentum      // 运行均值/方差的衰减率
    f64* gamma        // 缩放参数（可学习）
    f64* beta         // 偏移参数（可学习）
    f64* running_mean // 运行均值（推理用）
    f64* running_var  // 运行方差（推理用）
    f64* x_norm       // 归一化后的值（反向用）
    f64* x_mean       // batch 均值（反向用）
    f64* x_var        // batch 方差（反向用）
    f64* gx           // 输入梯度
    f64* ggamma       // gamma 梯度
    f64* gbeta        // beta 梯度
    i32 training      // 1=训练模式, 0=推理模式

    constructor(i32 dim) {
        self.dim = dim
        self.eps = 1e-5
        self.momentum = 0.1
        self.training = 1
        self.gamma = as<f64*>(std.memory.kmm_v4_global_alloc(dim * 8))
        self.beta = as<f64*>(std.memory.kmm_v4_global_alloc(dim * 8))
        self.running_mean = as<f64*>(std.memory.kmm_v4_global_alloc(dim * 8))
        self.running_var = as<f64*>(std.memory.kmm_v4_global_alloc(dim * 8))
        self.x_norm = as<f64*>(std.memory.kmm_v4_global_alloc(dim * 8))
        self.x_mean = as<f64*>(std.memory.kmm_v4_global_alloc(dim * 8))
        self.x_var = as<f64*>(std.memory.kmm_v4_global_alloc(dim * 8))
        self.gx = as<f64*>(std.memory.kmm_v4_global_alloc(dim * 8))
        self.ggamma = as<f64*>(std.memory.kmm_v4_global_alloc(dim * 8))
        self.gbeta = as<f64*>(std.memory.kmm_v4_global_alloc(dim * 8))
        // 初始化 gamma=1, beta=0
        for i in range(dim) {
            self.gamma[i] = 1.0
            self.beta[i] = 0.0
        }
    }

    // 前向传播: x 形状 [batch_size, dim]
    // 每行是一个样本，逐列归一化
    fn forward(f64* x, i32 batch_size) f64* {
        i32 total = batch_size * self.dim
        f64* out = as<f64*>(std.memory.kmm_v4_global_alloc(total * 8))

        if self.training == 1 {
            // 计算每个特征维度的均值
            for j in range(self.dim) {
                f64 sum = 0.0
                for i in range(batch_size) {
                    sum = sum + x[i * self.dim + j]
                }
                self.x_mean[j] = sum / as<f64>(batch_size)
            }
            // 计算每个特征维度的方差
            for j in range(self.dim) {
                f64 sum = 0.0
                for i in range(batch_size) {
                    f64 d = x[i * self.dim + j] - self.x_mean[j]
                    sum = sum + d * d
                }
                self.x_var[j] = sum / as<f64>(batch_size)
                // 更新运行均值/方差
                self.running_mean[j] = (1.0 - self.momentum) * self.running_mean[j] + self.momentum * self.x_mean[j]
                self.running_var[j] = (1.0 - self.momentum) * self.running_var[j] + self.momentum * self.x_var[j]
            }
            // 归一化
            for j in range(self.dim) {
                f64 inv_std = 1.0 / std.math.math_sqrt(self.x_var[j] + self.eps)
                for i in range(batch_size) {
                    f64 xn = (x[i * self.dim + j] - self.x_mean[j]) * inv_std
                    self.x_norm[i * self.dim + j] = xn
                    out[i * self.dim + j] = self.gamma[j] * xn + self.beta[j]
                }
            }
        } else {
            // 推理模式：用运行均值/方差
            for j in range(self.dim) {
                f64 inv_std = 1.0 / std.math.math_sqrt(self.running_var[j] + self.eps)
                for i in range(batch_size) {
                    f64 xn = (x[i * self.dim + j] - self.running_mean[j]) * inv_std
                    out[i * self.dim + j] = self.gamma[j] * xn + self.beta[j]
                }
            }
        }
        return out
    }

    // 反向传播: dy 形状 [batch_size, dim]
    fn backward(f64* dy, i32 batch_size) f64* {
        f64 inv_n = 1.0 / as<f64>(batch_size)
        // 梯度 gamma 和 beta
        for j in range(self.dim) {
            f64 g_gamma = 0.0
            f64 g_beta = 0.0
            for i in range(batch_size) {
                g_gamma = g_gamma + dy[i * self.dim + j] * self.x_norm[i * self.dim + j]
                g_beta = g_beta + dy[i * self.dim + j]
            }
            self.ggamma[j] = self.ggamma[j] + g_gamma
            self.gbeta[j] = self.gbeta[j] + g_beta
        }
        // 梯度输入
        for j in range(self.dim) {
            f64 inv_std = 1.0 / std.math.math_sqrt(self.x_var[j] + self.eps)
            f64 dx_mean = 0.0
            f64 dx_var = 0.0
            for i in range(batch_size) {
                f64 xn = self.x_norm[i * self.dim + j]
                dx_mean = dx_mean + dy[i * self.dim + j] * self.gamma[j]
                dx_var = dx_var + dy[i * self.dim + j] * self.gamma[j] * xn
            }
            for i in range(batch_size) {
                f64 dx = dy[i * self.dim + j] * self.gamma[j] * inv_std
                dx = dx - dx_mean * inv_n
                dx = dx - self.x_norm[i * self.dim + j] * dx_var * inv_n / as<f64>(self.dim)
                self.gx[i * self.dim + j] = dx
            }
        }
        return self.gx
    }

    fn train_mode() {
        self.training = 1
    }

    fn eval_mode() {
        self.training = 0
    }

    fn get_params_count() i32 {
        return self.dim * 2  // gamma + beta
    }
}
