import std.memory

export class Tensor {
    rows: i32
    cols: i32
    size: i32
    data: f64*

    constructor(i32 rows, i32 cols) {
        self.rows = rows
        self.cols = cols
        self.size = rows * cols
        self.data = as<f64*>(std.memory.kmm_v4_calloc(self.size, 8))
    }

    fn at(i32 r, i32 c) f64 {
        return self.data[r * self.cols + c]
    }

    fn set(i32 r, i32 c, f64 v) {
        self.data[r * self.cols + c] = v
    }

    fn fill(f64 v) {
        for i in range(self.size) {
            self.data[i] = v
        }
    }

    fn sum() f64 {
        f64 s = 0.0
        for i in range(self.size) {
            s = s + self.data[i]
        }
        return s
    }
}

export fn ml_matmul(a: Tensor, b: Tensor, out: Tensor) {
    for i in range(a.rows) {
        for j in range(b.cols) {
            f64 acc = 0.0
            for k in range(a.cols) {
                acc = acc + a.at(i, k) * b.at(k, j)
            }
            out.set(i, j, acc)
        }
    }
}