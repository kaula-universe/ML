import std.math

// 逐元素激活：in-place 修改 x[0..n)
export fn ops_relu(f64* x, i32 n) {
    for i in range(n) {
        if x[i] < 0.0 {
            x[i] = 0.0
        }
    }
}

// 逐元素 exp：直接调用标准库 std.math.math_exp
export fn ops_exp(f64 x) f64 {
    return std.math.math_exp(x)
}

export fn ops_sigmoid(f64* x, i32 n) {
    for i in range(n) {
        x[i] = 1.0 / (1.0 + ops_exp(-x[i]))
    }
}

export fn ops_tanh(f64* x, i32 n) {
    for i in range(n) {
        x[i] = std.math.math_tanh(x[i])
    }
}

// 数值稳定 softmax（先减最大值再 exp），结果写入 x
export fn ops_softmax(f64* x, i32 n) {
    f64 mx = x[0]
    for i in range(n) {
        if x[i] > mx {
            mx = x[i]
        }
    }
    f64 s = 0.0
    for i in range(n) {
        x[i] = ops_exp(x[i] - mx)
        s = s + x[i]
    }
    for i in range(n) {
        x[i] = x[i] / s
    }
}

// 逐元素二元运算（out 可与 x 或 y 相同）
export fn ops_add(f64* x, f64* y, f64* out, i32 n) {
    for i in range(n) {
        out[i] = x[i] + y[i]
    }
}

export fn ops_sub(f64* x, f64* y, f64* out, i32 n) {
    for i in range(n) {
        out[i] = x[i] - y[i]
    }
}

export fn ops_mul(f64* x, f64* y, f64* out, i32 n) {
    for i in range(n) {
        out[i] = x[i] * y[i]
    }
}

export fn ops_scale(f64* x, f64 s, f64* out, i32 n) {
    for i in range(n) {
        out[i] = x[i] * s
    }
}

// 点积 a·b
export fn ops_dot(f64* a, f64* b, i32 n) f64 {
    f64 s = 0.0
    for i in range(n) {
        s = s + a[i] * b[i]
    }
    return s
}

export fn ops_sum(f64* x, i32 n) f64 {
    f64 s = 0.0
    for i in range(n) {
        s = s + x[i]
    }
    return s
}

// 均方误差 (1/n) Σ(a[i]-b[i])²
export fn ops_mse(f64* a, f64* b, i32 n) f64 {
    f64 s = 0.0
    for i in range(n) {
        f64 d = a[i] - b[i]
        s = s + d * d
    }
    return s / as<f64>(n)
}

// MSE 损失梯度: out[i] = 2(a[i]-b[i])/n
export fn ops_mse_deriv(f64* a, f64* b, f64* out, i32 n) {
    f64 inv = 2.0 / as<f64>(n)
    for i in range(n) {
        out[i] = (a[i] - b[i]) * inv
    }
}

// 交叉熵损失梯度（softmax 输出层用）: out[i] = y[i] - t[i]
export fn ops_cross_entropy_deriv(f64* y, f64* target, f64* out, i32 n) {
    for i in range(n) {
        out[i] = y[i] - target[i]
    }
}

// 交叉熵损失 -Σ t[i]·log(y[i])（y 为 softmax 概率，t 为 one-hot 目标）
export fn ops_cross_entropy(f64* y, f64* target, i32 n) f64 {
    f64 s = 0.0
    for i in range(n) {
        if target[i] > 0.0 {
            s = s - target[i] * std.math.math_log(y[i])
        }
    }
    return s
}

// argmax：返回最大元素下标
export fn ops_argmax(f64* x, i32 n) i32 {
    i32 best = 0
    for i in range(n) {
        if x[i] > x[best] {
            best = i
        }
    }
    return best
}

// argmin：返回最小元素下标
export fn ops_argmin(f64* x, i32 n) i32 {
    i32 best = 0
    for i in range(n) {
        if x[i] < x[best] {
            best = i
        }
    }
    return best
}

// clip：把 x[i] 限制到 [lo, hi]
export fn ops_clip(f64* x, f64 lo, f64 hi, i32 n) {
    for i in range(n) {
        if x[i] < lo {
            x[i] = lo
        }
        if x[i] > hi {
            x[i] = hi
        }
    }
}