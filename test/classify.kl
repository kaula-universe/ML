import "../nn.kl"
import std.io
import std.memory

// XOR 分类：2-8-2 + 动量，交叉熵 + softmax 训练（输出层 act=0=logits）
fn main() {
    i32* dims = as<i32*>(std.memory.kmm_v4_alloc(3 * 4))
    i32* acts = as<i32*>(std.memory.kmm_v4_alloc(2 * 4))
    dims[0] = 2; dims[1] = 8; dims[2] = 2
    acts[0] = 1; acts[1] = 0
    MLP net = MLP(dims, 2, acts, 0.02)
    net.set_momentum(0.9)

    f64* x = as<f64*>(std.memory.kmm_v4_alloc(4 * 2 * 8))
    f64* t = as<f64*>(std.memory.kmm_v4_alloc(4 * 2 * 8))
    x[0] = 0.0; x[1] = 0.0; t[0] = 1.0; t[1] = 0.0
    x[2] = 0.0; x[3] = 1.0; t[2] = 0.0; t[3] = 1.0
    x[4] = 1.0; x[5] = 0.0; t[4] = 0.0; t[5] = 1.0
    x[6] = 1.0; x[7] = 1.0; t[6] = 1.0; t[7] = 0.0

    i32 epoch = 0
    while epoch < 15000 {
        f64 total = 0.0
        for s in range(4) {
            f64* xs = &x[s * 2]
            f64* ts = &t[s * 2]
            total = total + net.train_step_ce(xs, ts)
        }
        epoch = epoch + 1
    }

    i32 correct = 0
    for s in range(4) {
        f64* xs = &x[s * 2]
        f64* ts = &t[s * 2]
        f64* y = net.predict_softmax(xs)
        i32 pred = 0
        if y[1] > y[0] {
            pred = 1
        }
        i32 expect = 0
        if ts[1] > ts[0] {
            expect = 1
        }
        if pred == expect {
            correct = correct + 1
        }
        std.io.println("xor(", xs[0], ",", xs[1], ") pred ", pred, " expect ", expect)
    }
    std.io.println("accuracy = ", as<f64>(correct) / 4.0)
}